# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=student_grades_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# ---- JWT ----
# Generate a secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=1h

# ---- CORS / Cookies ----
# Comma-separated list of frontend origins allowed to call this API with cookies
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3001
# lax (same-site apps) | none (cross-site, requires HTTPS + NODE_ENV=production)
COOKIE_SAMESITE=lax

# ---- First admin (used only by: npm run seed:admin) ----
ADMIN_EMAIL=admin@university.edu
ADMIN_PASSWORD=Admin12345
